---
// placeholder: reemplazar por el número real de WhatsApp del centro
const whatsappNumber = '5490000000000';
const whatsappMessage = encodeURIComponent(
  'Hola, quiero solicitar un turno en Centro Médico de la Planta.'
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const benefits = [
  'Atención profesional y personalizada',
  'Respaldo científico y legal',
  'Acompañamiento para pacientes y ONG',
  'Salud integrativa para una mejor calidad de vida'
];
---

<section id="top" class="relative overflow-hidden bg-crema">
  <!-- Textura de fondo sutil -->
  <div 
    class="pointer-events-none absolute inset-0 opacity-[0.015]"
    style="background-image: repeating-linear-gradient(45deg, #1A1A17 0, #1A1A17 1px, transparent 1px, transparent 8px);"
    aria-hidden="true"
  ></div>

  <!-- Forma orgánica decorativa de fondo -->
  <div 
    class="pointer-events-none absolute right-0 top-0 h-full w-1/2 opacity-[0.025]"
    style="background: radial-gradient(ellipse at 65% 45%, #7E9C86 0%, transparent 55%);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto grid max-w-[1400px] grid-cols-1 items-center gap-8 px-6 py-20 md:min-h-[85vh] md:grid-cols-[42fr_58fr] md:gap-12 md:px-10 lg:gap-16 lg:px-12 xl:px-16">
    
    <!-- Columna izquierda: Contenido textual -->
    <div class="reveal flex flex-col gap-7 md:py-12 lg:gap-8">
      
      <!-- Eyebrow -->
      <div class="flex items-center gap-2.5">
        <span class="h-1.5 w-1.5 rounded-full bg-verde" aria-hidden="true"></span>
        <p class="font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-verde/80">
          Cannabis medicinal · Chubut
        </p>
      </div>

      <!-- Frase conceptual -->
      <p class="font-mono text-sm italic text-salvia">
        Volver a los orígenes sin abandonar la ciencia
      </p>

      <!-- Título principal -->
      <h1 class="font-display text-[2.75rem] font-semibold leading-[1.05] tracking-tight text-verde sm:text-5xl md:text-6xl lg:text-[4rem] xl:text-[4.5rem]">
        Cannabis medicinal con indicación y seguimiento
      </h1>

      <!-- Divisor decorativo -->
      <div class="flex items-center gap-3">
        <span class="block h-[1.5px] w-16 bg-ocre/80" aria-hidden="true"></span>
        <svg 
          viewBox="0 0 16 16" 
          class="h-3.5 w-3.5 text-ocre/70"
          fill="currentColor"
          aria-hidden="true"
        >
          <circle cx="8" cy="8" r="1.5" />
          <circle cx="3" cy="8" r="1" />
          <circle cx="13" cy="8" r="1" />
        </svg>
      </div>

      <!-- Descripción -->
      <p class="max-w-[520px] text-base leading-relaxed text-tinta/85 md:text-lg md:leading-relaxed">
        El cannabis medicinal es un tratamiento legal en Argentina. Acompañamos con médicos
        matriculados, indicación clínica y la gestión completa del REPROCANN.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col gap-3 sm:flex-row sm:gap-4">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2.5 rounded-lg bg-ocre px-7 py-4 font-body text-[15px] font-medium text-blanco shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-verde hover:shadow-md"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-[18px] w-[18px]"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 19.5 6 16a7.5 7.5 0 1 1 3 2.7L5 19.5Z" />
            <path d="M9.5 10.2c0 2.4 2 4.4 4.4 4.4" />
          </svg>
          Escribinos por WhatsApp
        </a>
        <a 
          href="#reprocann" 
          class="group inline-flex items-center justify-center gap-2 rounded-lg border-[1.5px] border-verde/40 bg-transparent px-7 py-4 font-body text-[15px] font-medium text-verde transition-all duration-300 hover:border-verde hover:bg-verde/5"
        >
          Cómo tramitar el REPROCANN
          <svg
            viewBox="0 0 16 16"
            class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </a>
      </div>

      <!-- Beneficios livianos -->
      <div class="mt-6 grid grid-cols-1 gap-3 border-t border-salvia/20 pt-7 sm:grid-cols-2 md:gap-x-6 md:gap-y-3">
        {benefits.map((benefit) => (
          <div class="flex items-start gap-2.5">
            <svg
              viewBox="0 0 16 16"
              class="mt-0.5 h-4 w-4 shrink-0 text-verde"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8l3 3 7-7" />
            </svg>
            <p class="text-[13px] leading-relaxed text-tinta/75">{benefit}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Columna derecha: Imagen protagonista -->
    <div class="reveal relative md:py-8 lg:py-12">
      
      <!-- Forma orgánica de fondo grande -->
      <div 
        class="pointer-events-none absolute -right-6 top-1/2 h-[85%] w-[92%] -translate-y-1/2 opacity-[0.08]"
        style="background: linear-gradient(165deg, #E8DCC8 0%, #D4C5B0 100%); border-radius: 48% 52% 45% 55% / 52% 48% 52% 48%;"
        aria-hidden="true"
      ></div>

      <!-- Ilustración botánica decorativa minimalista -->
      <svg
        viewBox="0 0 120 200"
        class="pointer-events-none absolute -left-4 top-8 text-verde opacity-[0.06] md:-left-6 lg:-left-8"
        style="width: min(100px, 18%); height: auto;"
        fill="none"
        stroke="currentColor"
        stroke-width="0.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M60 180 V40" />
        <path d="M60 100 C50 85 50 70 60 55 C70 70 70 85 60 100 Z" />
        <path d="M60 130 C52 118 52 105 60 90 C68 105 68 118 60 130 Z" transform="rotate(25 60 110)" />
        <path d="M60 130 C52 118 52 105 60 90 C68 105 68 118 60 130 Z" transform="rotate(-25 60 110)" />
      </svg>

      <!-- Contenedor de imagen editorial -->
      <div class="relative z-10">
        
        <!-- Microcopy editorial decorativo superior -->
        <div class="absolute -top-4 left-4 z-20 flex items-center gap-2 md:-top-5 md:left-5">
          <span class="rounded-full bg-verde/95 px-3 py-1.5 font-mono text-[10px] font-medium uppercase tracking-widest text-crema shadow-sm">
            Medicinal
          </span>
        </div>

        <!-- Imagen principal grande -->
        <div
          class="relative overflow-hidden rounded-3xl shadow-[0_20px_60px_rgba(30,58,43,0.12)]"
          style="aspect-ratio: 4 / 5;"
        >
          <img
            src="/imagenes/heros/cannabis-medicinal-tecsalud-2.jpg"
            alt="Planta de Cannabis sativa con las estructuras químicas de CBD y THC representando el respaldo científico del tratamiento medicinal"
            class="absolute inset-0 h-full w-full object-cover"
            style="object-position: center 35%;"
            width="900"
            height="573"
            fetchpriority="high"
            decoding="async"
          />
          
          <!-- Overlay muy sutil para mejorar composición -->
          <div class="absolute inset-0 bg-gradient-to-t from-verde/15 via-transparent to-transparent"></div>
        </div>

        <!-- Placa editorial inferior -->
        <div class="absolute bottom-5 left-5 right-5 z-20 rounded-2xl border border-salvia/20 bg-crema/98 px-5 py-3.5 shadow-lg backdrop-blur-sm md:bottom-6 md:left-6 md:right-auto md:max-w-[280px]">
          <p class="font-display text-sm italic leading-snug text-verde">
            Cannabis sativa L.
          </p>
          <div class="mt-1.5 flex items-center gap-2">
            <span class="h-px w-8 bg-salvia/40" aria-hidden="true"></span>
            <p class="font-mono text-[10px] uppercase tracking-wider text-tinta/60">
              Respaldo científico
            </p>
          </div>
        </div>

        <!-- Elemento decorativo botánico circular -->
        <div class="absolute -bottom-4 -right-4 z-20 flex h-20 w-20 items-center justify-center rounded-full bg-ocre shadow-xl md:-bottom-5 md:-right-5 md:h-24 md:w-24">
          <svg
            viewBox="0 0 24 24"
            class="h-9 w-9 text-blanco md:h-10 md:w-10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3C7.5 3 4 6.5 4 11c0 3.5 2 6.5 5 8v2h6v-2c3-1.5 5-4.5 5-8 0-4.5-3.5-8-8-8Z" />
            <path d="M12 11v10" />
          </svg>
        </div>
      </div>

      <!-- Línea decorativa vertical editorial -->
      <div class="pointer-events-none absolute -right-2 top-1/2 hidden -translate-y-1/2 lg:block" aria-hidden="true">
        <div class="flex flex-col items-center gap-3">
          <span class="h-12 w-[1px] bg-salvia/25"></span>
          <svg viewBox="0 0 16 16" class="h-2 w-2 text-salvia/30" fill="currentColor">
            <circle cx="8" cy="8" r="2" />
          </svg>
          <span class="h-12 w-[1px] bg-salvia/25"></span>
        </div>
      </div>
    </div>
  </div>
</section>
