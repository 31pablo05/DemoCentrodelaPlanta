---
const links = [
  { href: '#el-centro', label: 'El Centro' },
  { href: '#tratamientos', label: 'Tratamientos' },
  { href: '#reprocann', label: 'REPROCANN' },
  { href: '#profesionales', label: 'Profesionales' },
  { href: '#contacto', label: 'Contacto' }
];

// placeholder: reemplazar por el número real de WhatsApp del centro
const whatsappNumber = '5490000000000';
const whatsappMessage = encodeURIComponent(
  'Hola, quiero solicitar un turno en Centro Médico de la Planta.'
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<nav id="site-nav" class="fixed inset-x-0 top-0 z-50">
  <div class="nav-inner mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4 md:px-10">
    <a href="#top" class="flex shrink-0 items-center gap-3">
      <svg
        viewBox="0 0 40 48"
        class="h-10 w-auto"
        fill="none"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 44 V20 A14 14 0 0 1 34 20 V44" />
        <g stroke-width="0.7">
          <path d="M20 40 C17.4 32 17.4 22 20 13 C22.6 22 22.6 32 20 40 Z" />
          <path
            d="M20 40 C17.6 33 17.6 24 20 16 C22.4 24 22.4 33 20 40 Z"
            transform="rotate(24 20 40)"
          />
          <path
            d="M20 40 C17.6 33 17.6 24 20 16 C22.4 24 22.4 33 20 40 Z"
            transform="rotate(-24 20 40)"
          />
          <path
            d="M20 40 C18 35 18 28 20 21 C22 28 22 35 20 40 Z"
            transform="rotate(48 20 40)"
          />
          <path
            d="M20 40 C18 35 18 28 20 21 C22 28 22 35 20 40 Z"
            transform="rotate(-48 20 40)"
          />
          <path
            d="M20 40 C18.4 37 18.4 32 20 27 C21.6 32 21.6 37 20 40 Z"
            transform="rotate(68 20 40)"
          />
          <path
            d="M20 40 C18.4 37 18.4 32 20 27 C21.6 32 21.6 37 20 40 Z"
            transform="rotate(-68 20 40)"
          />
        </g>
      </svg>
      <span class="flex flex-col leading-none">
        <span class="font-display text-base font-semibold">Centro Médico</span>
        <span class="-mt-0.5 font-display text-base italic">de la Planta</span>
      </span>
    </a>

    <ul class="hidden flex-1 items-center justify-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="group relative font-body text-sm font-medium">
              {link.label}
              <span class="absolute -bottom-1 left-0 h-px w-0 bg-ocre transition-all duration-300 group-hover:w-full" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden shrink-0 md:block">
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-solido">
        Pedir turno
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="relative h-10 w-10 shrink-0 md:hidden"
      aria-label="Menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="hamburger-line absolute left-1/2 top-1/2 h-px w-5 -translate-x-1/2 bg-current transition-all duration-300" style="transform: translate(-50%, -6px);"></span>
      <span class="hamburger-line absolute left-1/2 top-1/2 h-px w-5 -translate-x-1/2 bg-current transition-all duration-300" style="transform: translate(-50%, -50%);"></span>
      <span class="hamburger-line absolute left-1/2 top-1/2 h-px w-5 -translate-x-1/2 bg-current transition-all duration-300" style="transform: translate(-50%, 6px);"></span>
    </button>
  </div>
</nav>

<!-- Backdrop atenuado -->
<div
  id="menu-backdrop"
  class="fixed inset-0 hidden bg-verde/20 backdrop-blur-sm transition-opacity duration-300"
  style="z-index: 59;"
>
</div>

<!-- Panel mobile -->
<div
  id="mobile-menu"
  class="fixed inset-x-0 hidden w-full border-t border-salvia/30 bg-crema shadow-lg md:hidden"
  style="z-index: 60; top: 72px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; box-shadow: 0 12px 32px rgba(30, 58, 43, 0.08);"
>
  <!-- Textura de papel -->
  <div class="absolute inset-0 opacity-30 mix-blend-multiply" style="background-image: url('data:image/svg+xml,%3Csvg width=\'100\' height=\'100\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' /%3E%3CfeColorMatrix type=\'saturate\' values=\'0\'/%3E%3C/filter%3E%3Crect width=\'100\' height=\'100\' filter=\'url(%23noise)\' opacity=\'0.05\'/%3E%3C/svg%3E'); border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;"></div>

  <div class="relative px-6 pb-6 pt-5">
    <!-- Enlaces -->
    <ul class="flex flex-col">
      {
        links.map((link, index) => (
          <li class="border-b border-salvia/15 last:border-0">
            <a
              href={link.href}
              class="mobile-link flex items-center justify-between py-4 font-display text-lg font-medium text-verde opacity-0 transition-all duration-300 hover:translate-x-1"
              style={`animation-delay: ${index * 50}ms;`}
            >
              <span class="flex items-center gap-4">
                <span class="font-mono text-[10px] font-medium text-ocre">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{link.label}</span>
              </span>
              <svg
                viewBox="0 0 16 16"
                class="h-3.5 w-3.5 text-salvia transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Footer del panel -->
    <div class="mt-5 border-t border-salvia/15 pt-5">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-link flex w-full items-center justify-center gap-2.5 rounded-lg bg-ocre px-6 py-3.5 font-body text-[15px] font-medium text-blanco opacity-0 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
        style="animation-delay: 250ms;"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-[18px] w-[18px]"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 19.5 6 16a7.5 7.5 0 1 1 3 2.7L5 19.5Z" />
          <path d="M9.5 10.2c0 2.4 2 4.4 4.4 4.4" />
        </svg>
        Escribinos por WhatsApp
      </a>
      <p class="mt-3 text-center font-mono text-[11px] text-verde/60">
        [+54 9 XXX XXX-XXXX]
      </p>
    </div>
  </div>
</div>

<style>
  #site-nav {
    @apply bg-transparent transition-all duration-300;
  }

  #site-nav .nav-inner {
    @apply text-verde transition-colors duration-300;
  }

  #site-nav.nav-scrolled {
    @apply bg-verde shadow-md;
  }

  #site-nav.nav-scrolled .nav-inner {
    @apply text-crema;
  }

  /* Mobile: barra con fondo verde desde el inicio */
  @media (max-width: 767px) {
    #site-nav {
      @apply bg-verde shadow-md;
    }
    #site-nav .nav-inner {
      @apply text-crema;
    }
  }

  /* Animación del botón hamburguesa a cruz */
  #menu-toggle.menu-open .hamburger-line:nth-child(1) {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  #menu-toggle.menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle.menu-open .hamburger-line:nth-child(3) {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Animación del panel */
  #mobile-menu {
    transform: translateY(-10px);
    opacity: 0;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  }

  #mobile-menu.menu-open {
    transform: translateY(0);
    opacity: 1;
  }

  /* Animación escalonada de enlaces */
  #mobile-menu.menu-open .mobile-link {
    animation: slideInFade 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes slideInFade {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Backdrop */
  #menu-backdrop {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #menu-backdrop.menu-open {
    opacity: 1;
  }
</style>

<script>
  const nav = document.getElementById('site-nav');

  const updateNavState = () => {
    if (window.scrollY > 80 && window.innerWidth >= 768) {
      nav?.classList.add('nav-scrolled');
    } else if (window.innerWidth >= 768) {
      nav?.classList.remove('nav-scrolled');
    }
  };

  updateNavState();
  window.addEventListener('scroll', updateNavState, { passive: true });
  window.addEventListener('resize', updateNavState, { passive: true });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuBackdrop = document.getElementById('menu-backdrop');
  const mobileLinks = mobileMenu?.querySelectorAll('.mobile-link');

  let isMenuOpen = false;

  const openMenu = () => {
    isMenuOpen = true;
    mobileMenu?.classList.remove('hidden');
    menuBackdrop?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Forzar reflow antes de agregar la clase de animación
    void mobileMenu?.offsetHeight;
    
    mobileMenu?.classList.add('menu-open');
    menuBackdrop?.classList.add('menu-open');
    menuToggle?.classList.add('menu-open');
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.setAttribute('aria-label', 'Cerrar menú');
  };

  const closeMenu = () => {
    isMenuOpen = false;
    mobileMenu?.classList.remove('menu-open');
    menuBackdrop?.classList.remove('menu-open');
    menuToggle?.classList.remove('menu-open');
    
    // Esperar a que termine la animación antes de ocultar
    setTimeout(() => {
      if (!isMenuOpen) {
        mobileMenu?.classList.add('hidden');
        menuBackdrop?.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }, 300);
    
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú');
  };

  const toggleMenu = () => {
    if (isMenuOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  };

  menuToggle?.addEventListener('click', toggleMenu);
  menuBackdrop?.addEventListener('click', closeMenu);
  mobileLinks?.forEach((link) => link.addEventListener('click', closeMenu));

  // Cerrar menú al cambiar a desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isMenuOpen) {
      closeMenu();
    }
  });
</script>
