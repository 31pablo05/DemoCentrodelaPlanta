<section id="profesionales" class="bg-crema py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <p class="label-section">Profesionales</p>
    <h2 class="mt-4 font-display text-4xl font-semibold leading-tight text-verde sm:text-5xl">
      Quién te va a atender
    </h2>

    <div class="reveal mt-16 flex flex-col gap-10 md:flex-row md:items-start md:gap-8">
      <div
        class="group border border-salvia bg-blanco p-8 transition-all duration-300 hover:-translate-y-1 hover:border-verde md:-mt-10 md:w-[38%] md:p-10"
      >
        <div class="mx-auto w-full max-w-sm">
          <div
            class="img-placeholder border-x border-t border-b-0"
            style="aspect-ratio: 2 / 1; border-radius: 50% 50% 0 0;"
          ></div>
          <div class="img-placeholder -mt-px border-x border-b border-t-0" style="aspect-ratio: 3 / 4;">
            <span>RETRATO B&amp;N</span>
          </div>
        </div>

        <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-ocre">Dirección médica</p>
        <p class="mt-2 font-display text-2xl text-verde">[Nombre Apellido]</p>
        <p class="mt-1 text-base text-tinta/80">Médica especialista en dolor y cuidados paliativos</p>

        <hr class="mt-5 border-t border-salvia/40" />
        <p class="mt-3 font-mono text-xs uppercase tracking-[0.1em] text-tinta/60">
          [M.P. 0000 · Chubut]
        </p>
      </div>

      <div
        class="group border border-salvia bg-blanco p-6 transition-all duration-300 hover:-translate-y-1 hover:border-verde md:w-[31%]"
      >
        <div class="mx-auto w-full" style="max-width: 220px;">
          <div
            class="img-placeholder border-x border-t border-b-0"
            style="aspect-ratio: 2 / 1; border-radius: 50% 50% 0 0;"
          ></div>
          <div class="img-placeholder -mt-px border-x border-b border-t-0" style="aspect-ratio: 3 / 4;">
            <span>RETRATO B&amp;N</span>
          </div>
        </div>

        <p class="mt-6 font-display text-lg text-verde">[Nombre Apellido]</p>
        <p class="mt-1 text-sm text-tinta/80">Médica generalista</p>

        <hr class="mt-4 border-t border-salvia/40" />
        <p class="mt-3 font-mono text-xs uppercase tracking-[0.1em] text-tinta/60">
          [M.P. 0000 · Chubut]
        </p>
      </div>

      <div
        class="group border border-salvia bg-blanco p-6 transition-all duration-300 hover:-translate-y-1 hover:border-verde md:w-[31%]"
      >
        <div class="mx-auto w-full" style="max-width: 220px;">
          <div
            class="img-placeholder border-x border-t border-b-0"
            style="aspect-ratio: 2 / 1; border-radius: 50% 50% 0 0;"
          ></div>
          <div class="img-placeholder -mt-px border-x border-b border-t-0" style="aspect-ratio: 3 / 4;">
            <span>RETRATO B&amp;N</span>
          </div>
        </div>

        <p class="mt-6 font-display text-lg text-verde">[Nombre Apellido]</p>
        <p class="mt-1 text-sm text-tinta/80">Especialista en neurología</p>

        <hr class="mt-4 border-t border-salvia/40" />
        <p class="mt-3 font-mono text-xs uppercase tracking-[0.1em] text-tinta/60">
          [M.P. 0000 · Chubut]
        </p>
      </div>
    </div>
  </div>
</section>
