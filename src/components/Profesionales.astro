    <div class="reveal mt-16 flex flex-col gap-10 md:flex-row md:items-start md:gap-8">
      <div
        class="group rounded-[28px] border border-salvia/20 bg-blanco p-8 shadow-[0_10px_24px_rgba(30,58,43,0.045)] transition-all duration-300 hover:-translate-y-1 md:-mt-10 md:w-[38%] md:p-10"
      >
        <div class="mx-auto w-full max-w-sm">
          <div class="img-placeholder aspect-[4/5] overflow-hidden rounded-[24px] object-cover">
            <span>RETRATO B&amp;N</span>
          </div>
        </div>

        <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-ocre">Dirección médica</p>
