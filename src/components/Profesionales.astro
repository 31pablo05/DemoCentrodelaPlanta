        <hr class="mt-4 border-t border-salvia/20" />
        <p class="mt-3 font-mono text-xs uppercase tracking-[0.1em] text-tinta/60">
          [M.P. 0000 · Chubut]
        </p>
      </div>

      <div
        class="group rounded-[28px] border border-salvia/20 bg-blanco p-6 shadow-[0_6px_18px_rgba(30,58,43,0.03)] transition-all duration-300 hover:-translate-y-1 md:w-[31%]"
