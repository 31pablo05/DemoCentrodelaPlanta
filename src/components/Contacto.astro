---
// placeholder: reemplazar por el número real de WhatsApp del centro
const whatsappNumber = '5490000000000';
const whatsappMessage = encodeURIComponent(
  'Hola, quiero coordinar una consulta en Centro Médico de la Planta.'
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section id="contacto" class="border-t border-salvia/25 bg-crema py-24 md:py-32">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-12 px-6 md:grid-cols-2 md:gap-16 md:px-10">
    <div class="reveal w-full">
      <div class="img-placeholder aspect-square overflow-hidden rounded-[32px]">
        <span>MAPA · UBICACIÓN DEL CENTRO</span>
      </div>
    </div>

    <div class="reveal flex flex-col">
      <p class="label-section">Contacto</p>
      <h2 class="mt-4 font-display text-4xl font-semibold leading-tight text-verde sm:text-5xl">
        Coordinamos tu consulta
      </h2>

      <div class="mt-10">
        <p class="label-section">Dirección</p>
        <p class="mt-2 font-body text-tinta/90">[Calle y número — placeholder]</p>
        <p class="font-body text-tinta/90">[Localidad y provincia — placeholder]</p>
      </div>

      <div class="mt-6">
        <p class="label-section">Horarios de atención</p>
        <p class="mt-2 font-body text-tinta/90">[Días de atención — placeholder]</p>
        <p class="font-body text-tinta/90">[Horario — placeholder]</p>
      </div>

      <hr class="my-8 border-t border-salvia/25" />

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-solido flex w-full flex-col items-center justify-center py-5 text-center"
      >
        <span class="font-semibold">Escribinos por WhatsApp</span>
        <span class="mt-1 text-xs font-normal">[Número placeholder — +54 9 XXX XXX-XXXX]</span>
      </a>

      <div class="mt-5 flex gap-3">
        <a
          href="#"
          aria-label="Instagram (placeholder)"
          class="group flex h-[52px] w-[52px] items-center justify-center rounded-full border border-salvia/40 text-verde transition-colors duration-300 hover:border-verde hover:text-ocre"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <rect x="3.5" y="3.5" width="17" height="17" rx="4" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="16.5" cy="7.5" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="#"
          aria-label="Facebook (placeholder)"
          class="group flex h-[52px] w-[52px] items-center justify-center rounded-full border border-salvia/40 text-verde transition-colors duration-300 hover:border-verde hover:text-ocre"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d="M14.5 8.5h-2a1.5 1.5 0 0 0-1.5 1.5v2H9v2.5h2V20h2.5v-5.5H15l.5-2.5h-2V10c0-.28.22-.5.5-.5h1.5V8.5Z" />
          </svg>
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp (placeholder)"
          class="group flex h-[52px] w-[52px] items-center justify-center rounded-full border border-salvia/40 text-verde transition-colors duration-300 hover:border-verde hover:text-ocre"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 19.5 6 16a7.5 7.5 0 1 1 3 2.7L5 19.5Z" />
            <path d="M9.5 10.2c0 2.4 2 4.4 4.4 4.4" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
