---
const treatments = [
  {
    title: 'Dolor crónico',
    description:
      'Dolor persistente de origen musculoesquelético, neuropático u oncológico que no cede con el esquema habitual.',
    icon: `
      <circle cx="18" cy="8" r="4" />
      <path d="M18 12v10M12 18l6-2 6 2M14 30l4-8 4 8" />
      <circle cx="27" cy="17" r="1.3" fill="currentColor" stroke="none" />
      <path d="M30 14l3-2M31 17h4M30 20l3 2" stroke-linecap="round" />
    `
  },
  {
    title: 'Trastornos del sueño',
    description:
      'Insomnio de conciliación o mantenimiento, sueño fragmentado y cuadros asociados al dolor nocturno.',
    icon: `
      <path d="M25 8a12 12 0 1 0 7 21 9 9 0 0 1-7-21Z" />
      <path d="M8 30h10M8 34h6" stroke-linecap="round" />
    `
  },
  {
    title: 'Ansiedad',
    description:
      'Cuadros de ansiedad generalizada, con abordaje conjunto y derivación a salud mental cuando hace falta.',
    icon: `
      <path d="M4 16c2-7 6-7 8 0s6 7 8 0 6-7 8 0 6 7 8 0" />
      <path d="M4 25c2-3 6-3 8 0s6 3 8 0 6-3 8 0 6 3 8 0" />
    `
  },
  {
    title: 'Epilepsia refractaria',
    description:
      'Epilepsias que no responden a los antiepilépticos convencionales, en pacientes adultos y pediátricos.',
    icon: `
      <path d="M4 20h4l3-11 4 20 3-16 3 12 3-7 3 5h9" stroke-linecap="round" stroke-linejoin="round" />
    `
  },
  {
    title: 'Cuidados paliativos',
    description:
      'Control de síntomas y mejora del descanso en etapas avanzadas de enfermedad, junto al equipo tratante.',
    icon: `
      <path d="M6 21c0 6 5 10 14 10s14-4 14-10" />
      <path d="M6 21c2-4 6-6 8-4M34 21c-2-4-6-6-8-4" />
      <circle cx="20" cy="17" r="2.5" />
    `
  },
  {
    title: 'Acompañamiento oncológico',
    description:
      'Manejo de náuseas, falta de apetito y dolor durante y después del tratamiento oncológico.',
    icon: `
      <path d="M13 29c-4-8-2-17 5-21 2 9-1 17-5 21Z" />
      <path d="M28 9v14M21 16h14" stroke-linecap="round" />
    `
  }
];
---

<section id="tratamientos" class="bg-crema py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div class="reveal grid grid-cols-1 gap-8 md:grid-cols-2 md:items-end">
      <div class="flex flex-col gap-4">
        <p class="label-section">Tratamientos y abordajes</p>
        <h2 class="font-display text-4xl font-semibold leading-tight text-verde sm:text-5xl">
          En qué casos indicamos cannabis
        </h2>
      </div>
      <p class="font-body text-tinta/80" style="max-width: 46ch;">
        Cada indicación se evalúa en consulta. Estos son los cuadros que se atienden con mayor
        frecuencia.
      </p>
    </div>

    <div class="reveal mt-16 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        treatments.map((treatment) => (
          <article class="rounded-[24px] border border-salvia/20 bg-blanco p-8 shadow-[0_8px_20px_rgba(30,58,43,0.04)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_24px_rgba(30,58,43,0.07)]">
            <svg
              viewBox="0 0 40 40"
              class="h-10 w-10 text-verde"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={treatment.icon}
            />
            <h3 class="mt-5 font-display text-xl text-verde">{treatment.title}</h3>
            <p class="mt-2 text-sm text-tinta/70">{treatment.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
