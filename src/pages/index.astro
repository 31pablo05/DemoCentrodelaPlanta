---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Confianza from '../components/Confianza.astro';
import ElCentro from '../components/ElCentro.astro';
import Tratamientos from '../components/Tratamientos.astro';
import Reprocann from '../components/Reprocann.astro';
